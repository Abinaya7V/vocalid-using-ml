# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/vocalid
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/vocalid
MONGO_URI=mongodb://localhost:27017/vocalid

# ─── JWT ──────────────────────────────────────────────────────
# Generate a strong random secret for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=vocalid_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=8h
